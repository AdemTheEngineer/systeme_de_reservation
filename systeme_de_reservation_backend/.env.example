# Copier ce fichier vers `.env` et adapter les valeurs.
# `uv run python manage.py runserver` (ou Docker Compose) lit `.env`
# automatiquement via django-environ.

# --- Django ---
SECRET_KEY=change-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données PostgreSQL (une seule base partagée par tous les contextes) ---
DB_NAME=systeme_reservation_db
DB_USER=adem
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432

# --- JWT (djangorestframework-simplejwt) ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
